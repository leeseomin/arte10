# 로컬 입력 사진. 이미 추적 중인 샘플은 유지하며, 새 샘플은 git add -f로 추가
/s/*

# 기본 결과 폴더. -o로 다른 경로를 사용하면 해당 경로를 별도로 추가
# out/은 README의 샘플 이미지 폴더이므로 제외하지 않음
/s25/

# 예전 파이프라인의 번호별 작업 폴더 (s1 ~ s38)
/s[1-9]/
/s[12][0-9]/
/s3[0-8]/

# main.sh의 중간 이미지와 실행 잠금 (-o로 지정한 폴더에도 적용)
_work/
.arte10-run.*/
.arte10-main.lock/

# README의 ffmpeg 예제로 생성하는 파일
/out.mp4
/apngout.apng

# macOS
.DS_Store
._*
